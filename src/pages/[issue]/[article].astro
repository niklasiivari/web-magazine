---
import { getCollection, getEntry, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { articleSlug } from "../../lib/content";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.isDraft);
  return articles.map((article) => ({
    params: {
      issue: article.data.issue.id,
      article: articleSlug(article.id),
    },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const issue = await getEntry(article.data.issue);
---

<ArticleLayout
  title={article.data.title}
  subtitle={article.data.subtitle}
  author={article.data.author}
  cover={article.data.cover}
  issueTitle={issue?.data.title}
  issueHref={`/${article.data.issue.id}`}
>
  <Content />
</ArticleLayout>
